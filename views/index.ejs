<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hackathon 2025</title>
    <!-- CSS Utama -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- Font Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;800&display=swap" rel="stylesheet">
    <!-- Font Awesome untuk Ikon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="logo">HACKATHON</div>
        <ul class="nav-links">
            <li><a href="#hero">Home</a></li>
            <li><a href="#mentors">Mentor & Jury</a></li>
            <li><a href="#prizes">Prizes</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#timeline">Timeline</a></li>
            <li><a href="#faq">FAQ</a></li>
        </ul>
        <div class="auth-buttons">
            <div class="dropdown">
                <button class="btn-login-dropdown" id="loginBtn">
                    Account <span class="arrow">▼</span>
                </button>
                <div class="dropdown-menu" id="loginMenu">
                    <a href="/login">Login</a>
                    <a href="/register">Register</a>
                    <a href="/dashboard">My Dashboard</a>
                    <a href="/admin">Admin Panel</a> <!-- TOMBOL ADMIN DISINI -->
                </div>
            </div>
        </div>
    </nav>

    <!-- HERO SECTION -->
    <section id="hero" class="hero">
        <div class="hero-bg-animation">
            <div class="orb orb-1"></div>
            <div class="orb orb-2"></div>
        </div>
        <div class="hero-content">
            <span class="badge">#KompetisiHackathon2025</span>
            <h1>Hackathon 2025</h1>
            <h2>Menciptakan Inovasi Digital<br>untuk Solusi Masa Depan</h2>
            <p class="hero-description">
                Hackathon 2025 adalah kompetisi inovasi teknologi yang mempertemukan mahasiswa 
                untuk berkolaborasi, berkreasi, dan mengembangkan solusi digital dalam waktu terbatas.
            </p>
            <a href="/register" class="btn-primary">Register Now</a>
        </div>
    </section>

    <!-- MENTOR SECTION -->
    <section id="mentors" class="container reveal">
        <div class="section-title">
            <span class="badge">#TechEnthusiast</span>
            <h2>Mentor & Jury</h2>
            <p>Didukung oleh para profesional dan praktisi berpengalaman.</p>
        </div>
        
        <div class="scroll-container">
            <div class="card"><div class="img-placeholder"><img src="/image/kevin.png" alt="Kevin Aluwi" onerror="this.style.display='none'"></div><div class="card-info"><h3>Kevin Aluwi</h3><p>Co-Founder Gojek</p></div></div>
            <div class="card"><div class="img-placeholder"><img src="/image/martijn.png" alt="Martijn Peeters" onerror="this.style.display='none'"></div><div class="card-info"><h3>Martijn Peeters</h3><p>President Director PwC</p></div></div>
            <div class="card"><div class="img-placeholder"><img src="/image/andrew.png" alt="Andrew Darwis" onerror="this.style.display='none'"></div><div class="card-info"><h3>Andrew Darwis</h3><p>CEO Kaskus</p></div></div>
            <div class="card"><div class="img-placeholder"><img src="/image/satya.png" alt="Satya Nadella" onerror="this.style.display='none'"></div><div class="card-info"><h3>Satya Nadella</h3><p>CEO Microsoft</p></div></div>
            <div class="card"><div class="img-placeholder"><img src="/image/julian.png" alt="Julian Lau" onerror="this.style.display='none'"></div><div class="card-info"><h3>Julian Lau</h3><p>Head of ASEAN Tech</p></div></div>
            <div class="card"><div class="img-placeholder"><img src="/image/aju.png" alt="Aju Widya Sari" onerror="this.style.display='none'"></div><div class="card-info"><h3>Aju Widya Sari</h3><p>Director of Tech</p></div></div>
            <div class="card"><div class="img-placeholder"><img src="/image/jaime.png" alt="Jaime Teevan" onerror="this.style.display='none'"></div><div class="card-info"><h3>Jaime Teevan</h3><p>Chief Scientist</p></div></div>
            <div class="card"><div class="img-placeholder"><img src="/image/krishna.png" alt="Krishna Patil" onerror="this.style.display='none'"></div><div class="card-info"><h3>Krishna Patil</h3><p>VP of Engineering</p></div></div>
            <div class="card"><div class="img-placeholder"><img src="/image/jimmi.png" alt="Jimmi Saputra" onerror="this.style.display='none'"></div><div class="card-info"><h3>Jimmi Saputra</h3><p>Founder Tiga Digital</p></div></div>
            <div class="card"><div class="img-placeholder"><img src="/image/setiaji.png" alt="Setiaji" onerror="this.style.display='none'"></div><div class="card-info"><h3>Setiaji</h3><p>Chief of DTO Kemenkes</p></div></div>
        </div>
        <p class="scroll-hint">← Geser untuk melihat mentor lainnya →</p>
    </section>

    <!-- PRIZES SECTION -->
    <section id="prizes" class="container reveal">
        <div class="section-title">
            <span class="badge">#BeTheWinner</span>
            <h2>Champion Prize</h2>
        </div>
        
        <div class="prize-grid">
            <div class="prize-card-wrapper">
                <div class="prize-card silver" data-tilt>
                    <div class="prize-content"><div class="prize-icon"><i class="fas fa-trophy"></i></div><h3>Juara 2</h3><h2 class="price">Rp 5.000.000</h2><ul class="benefits"><li>+ Merchandise Eksklusif</li><li>+ Sertifikat Nasional</li></ul></div>
                </div>
                <div class="pedestal silver-base">2nd</div>
            </div>
            <div class="prize-card-wrapper main">
                <div class="prize-card gold" data-tilt>
                    <div class="prize-glow"></div>
                    <div class="prize-content"><div class="prize-icon"><i class="fas fa-crown"></i></div><h3>Juara 1</h3><h2 class="price">Rp 10.000.000</h2><ul class="benefits"><li>+ Merchandise Eksklusif</li><li>+ Sertifikat Nasional</li><li>+ Kesempatan Magang</li></ul></div>
                </div>
                <div class="pedestal gold-base">1st</div>
            </div>
            <div class="prize-card-wrapper">
                <div class="prize-card bronze" data-tilt>
                    <div class="prize-content"><div class="prize-icon"><i class="fas fa-medal"></i></div><h3>Juara 3</h3><h2 class="price">Rp 2.500.000</h2><ul class="benefits"><li>+ Merchandise Eksklusif</li><li>+ Sertifikat Nasional</li></ul></div>
                </div>
                <div class="pedestal bronze-base">3rd</div>
            </div>
        </div>
    </section>

    <!-- ABOUT SECTION -->
    <section id="about" class="container reveal">
        <div class="section-title">
            <span class="badge">#Hackathon2025</span>
            <h2 class="title-hero-style">Tentang Kompetisi</h2>
            <p>Didukung oleh para profesional dan praktisi berpengalaman di bidang teknologi, inovasi, dan industri digital.</p>
        </div>

        <div class="about-wrapper">
            <div class="about-visuals">
                <div class="main-visual-box">
                    <video controls class="video-thumbnail">
                        <source src="/image/videotecnoscapebncc.mp4" type="video/mp4">
                        Browser kamu gak support video ini :(
                    </video>
                </div>
                <div class="visual-grid">
                    <div class="visual-item"><img src="/image/1.png" alt="Momen 1"></div>
                    <div class="visual-item"><img src="/image/2.png" alt="Momen 2"></div>
                    <div class="visual-item"><img src="/image/3.png" alt="Momen 3"></div>
                    <div class="visual-item"><img src="/image/4.png" alt="Momen 4"></div>
                    <div class="visual-item"><img src="/image/5.png" alt="Momen 5"></div>
                </div>
            </div>
            <div class="about-text">
                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Placerat molestie at augue in sit pharetra euismod eu. Orci egestas blandit lobortis tincidunt. Praesent dui diam blandit nascetur feugiat.</p>
                <p>Nunc imperdiet semper bibendum gravida auctor consequat ipsum porta sit. Enim tellus venenatis venenatis tortor sapien. Volutpat at condimentum feugiat viverra arcu nisi quam leo. Feugiat augue pretium a tincidunt eget amet pretium.</p>
                <p>Aenean mauris faucibus quam facilisis quis lorem. Pretium nibh non id amet orci a nam diam phasellus. Justo sem dolor nulla vitae tristique vestibulum. Mauris commodo proin imperdiet molestie nisi dapibus facilisis. Mi ornare neque convallis urna varius duis. Sed turpis arcu pretium nisi luctus mauris.</p>
                <a href="#" class="btn-primary" style="margin-top: 20px; font-size: 1rem; padding: 12px 30px;">Download Guidebook (PDF)</a>
            </div>
        </div>
    </section>

    <!-- TIMELINE SECTION -->
    <section id="timeline" class="container reveal">
        <div class="section-title">
            <span class="badge">#RoadToVictory</span>
            <h2>Timeline</h2>
            <p>Catat tanggal pentingnya biar nggak ketinggalan!</p>
        </div>
        <div class="timeline-wrapper">
            <div class="timeline-item"><div class="timeline-marker"><i class="fas fa-file-signature"></i></div><div class="timeline-content"><span class="date">10 Februari 2025</span><h3>Open Registration</h3><p>Pendaftaran dibuka untuk seluruh mahasiswa. Siapkan tim terbaikmu!</p></div></div>
            <div class="timeline-item"><div class="timeline-marker"><i class="fas fa-ban"></i></div><div class="timeline-content"><span class="date">20 Februari 2025</span><h3>Close Registration</h3><p>Batas akhir pendaftaran dan pengumpulan berkas tim.</p></div></div>
            <div class="timeline-item"><div class="timeline-marker"><i class="fas fa-chalkboard-teacher"></i></div><div class="timeline-content"><span class="date">25 Februari 2025</span><h3>Technical Meeting</h3><p>Penjelasan teknis lomba dan pembagian sesi mentoring.</p></div></div>
            <div class="timeline-item"><div class="timeline-marker"><i class="fas fa-rocket"></i></div><div class="timeline-content"><span class="date">1 Maret 2025</span><h3>Competition Day</h3><p>Hari H Hackathon! Waktunya coding dan presentasi inovasi.</p></div></div>
        </div>
    </section>

    <!-- FAQ SECTION -->
    <section id="faq" class="container reveal">
        <div class="section-title">
            <span class="badge">#FAQ</span>
            <h2 class="title-hero-style">Questions, Answered</h2>
            <p>Pertanyaan yang sering ditanyakan oleh peserta.</p>
        </div>
        <div class="faq-wrapper">
            <div class="faq-item"><div class="faq-header"><h4>Gimana cara daftarnya?</h4><div class="faq-icon"><i class="fas fa-plus"></i></div></div><div class="faq-body"><p>Klik tombol register di atas, isi data tim kamu, dan tunggu verifikasi ya!</p></div></div>
            <div class="faq-item active"><div class="faq-header"><h4>Apakah berbayar?</h4><div class="faq-icon"><i class="fas fa-minus"></i></div></div><div class="faq-body"><p>Gratis tis tis! Malah dapet hadiah kalau menang. Kami ingin memberikan kesempatan bagi semua mahasiswa.</p></div></div>
            <div class="faq-item"><div class="faq-header"><h4>Apa syarat pesertanya?</h4><div class="faq-icon"><i class="fas fa-plus"></i></div></div><div class="faq-body"><p>Mahasiswa aktif D3/S1/S2 di seluruh Indonesia. Satu tim 3-5 orang.</p></div></div>
            <div class="faq-item"><div class="faq-header"><h4>Apakah harus bisa coding?</h4><div class="faq-icon"><i class="fas fa-plus"></i></div></div><div class="faq-body"><p>Sebaiknya ada yang bisa coding, tapi ide bisnis dan desain juga sangat penting dalam penilaian.</p></div></div>
        </div>
    </section>

    <!-- SPONSOR SECTION -->
    <section id="sponsors" class="container reveal">
        <div class="section-title">
            <span class="badge">#Hackathon2025</span>
            <h2 class="title-hero-style">Our Sponsors</h2>
            <p>Mitra dan Partner yang membantu Hackathon2025 dapat berlangsung.</p>
        </div>
        <div class="sponsor-wrapper">
            <div class="sponsor-tier platinum"><h3 class="tier-title platinum-text">Platinum</h3><div class="sponsor-logos"><img src="/image/logitech.png" alt="Logitech" class="sponsor-img platinum-img"></div></div>
            <div class="sponsor-tier gold"><h3 class="tier-title gold-text">Gold</h3><div class="sponsor-logos"><img src="/image/intel.png" alt="Intel" class="sponsor-img gold-img"><img src="/image/tiket.png" alt="Tiket.com" class="sponsor-img gold-img"></div></div>
            <div class="sponsor-tier silver"><h3 class="tier-title silver-text">Silver</h3><div class="sponsor-logos"><img src="/image/shopee.png" alt="Shopee" class="sponsor-img silver-img"><img src="/image/microsoft.png" alt="Microsoft" class="sponsor-img silver-img"><img src="/image/gojek.png" alt="Gojek" class="sponsor-img silver-img"><img src="/image/tokped.png" alt="Tokopedia" class="sponsor-img silver-img"></div></div>
        </div>
    </section>


// File: prisma/schema.prisma

generator client {
  provider = "prisma-client-js" // Pastikan ada '-js' di ujungnya
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Team {
  id        String   @id @default(cuid())
  teamName  String   @unique
  createdAt DateTime @default(now())

  // Relasi balik ke Leader
  leader    Leader?
}

model Leader {
  id          String   @id @default(cuid())
  fullName    String
  email       String   @unique
  password    String   // hashed with bcrypt
  isBinusian  Boolean
  ContactNum  String   @unique
  LineID      String   @unique
  githubID    String
  birthPlace  String
  birthDate   DateTime
  cvPath      String
  idCardPath  String
  createdAt   DateTime @default(now())
  updateAt    DateTime @updatedAt // SUDAH DIPERBAIKI: DateTime (T kapital)

  // RELASI:
  // 1. teamId (pake 'd' kecil) sebagai foreign key (Scalar Field)
  teamId      String   @unique 
  
  // 2. team (objek) sebagai jembatan relasi ke model Team
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

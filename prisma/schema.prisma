generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Team{
  id          String @id @default(cuid())
  teamName    String @unique
  createdAt   DateTime @default(now())

  leader      Leader?  
}

model Leader{
  id          String   @id @default(cuid())
  teamID      String   @unique
  fullName    String
  email       String   @unique
  password    String  //hashed with bcrypt
  isBinusian  Boolean
  ContactNum  String   @unique
  LineID      String   @unique
  githubID    String
  birthPlace  String
  birthDate   DateTime
  cvPath      String
  idCardPath  String
  createdAt   DateTime @default(now())
  updateAt    Datetime @updatedAt

  teamID      Team     @relation(fields: [teamID], references: [id], onDelete: Cascade)      
}
